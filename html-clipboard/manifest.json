{
  "manifest_version": 3,
  "name": "HTML Clipboard",
  "version": "1.0.0",
  "description": "開いているHTMLをファイルとしてクリップボードにコピーします。Slackなどに貼り付けるとファイルが添付されます。",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HTMLをファイルとしてコピー",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
