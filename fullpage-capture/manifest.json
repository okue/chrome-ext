{
  "manifest_version": 3,
  "name": "Fullpage Capture",
  "version": "0.3.0",
  "description": "ページ全体のスクロールキャプチャ / クリップボードの画像を、切り抜き・注釈・黒塗りしてから保存/コピーする。外部通信なし。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "unlimitedStorage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ページ全体をキャプチャ (⌘⇧S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      }
    },
    "open-editor": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "編集画面を開く (クリップボードの画像を ⌘V で貼り付けて編集)"
    }
  }
}
