{
  "manifest_version": 3,
  "name": "Fullpage Capture",
  "version": "0.1.0",
  "description": "ページ全体をスクロールキャプチャして、切り抜き・注釈・黒塗りをしてから保存/コピーする。外部通信なし。",
  "permissions": ["activeTab", "scripting", "unlimitedStorage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ページ全体をキャプチャ (Alt+Shift+P)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" }
    }
  }
}
